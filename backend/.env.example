# "real" streams the CoreSignal JSONL blob from Azure; "demo" generates fictional profiles (no names).
DATA_MODE=demo

# Azure source (real mode). Provide either a SAS token + account, or a connection string.
AZURE_STORAGE_ACCOUNT=
AZURE_CONTAINER=
AZURE_RAW_BLOB=
AZURE_STORAGE_SAS_TOKEN=
AZURE_STORAGE_CONNECTION_STRING=

# Secret required in the X-Refresh-Token header for POST /api/refresh. Leave empty to disable refresh.
REFRESH_TOKEN=

# Include public profile URLs in candidate details (real mode only).
SHOW_PROFILE_URL=false

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
